{
  "name": "@carsale/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "test": "npm run test:tax && npm run test:cars && npm run test:config && npm run test:inquiries && npm run test:scraper && npm run test:uploads && npm run test:users && npm run test:website-values",
    "test:tax": "tsx --test src/cars/tax-calculator.spec.ts",
    "test:cars": "tsx --test src/cars/cars.service.spec.ts",
    "test:scraper": "tsx --test src/scraper/scraper.service.spec.ts",
    "test:config": "tsx --test src/config/environment.spec.ts",
    "test:inquiries": "tsx --test src/inquiries/inquiries.service.spec.ts",
    "test:uploads": "tsx --test src/uploads/uploads.service.spec.ts",
    "test:users": "tsx --test src/users/users.service.spec.ts",
    "test:website-values": "tsx --test src/website-values/website-value-matcher.spec.ts",
    "import:raize-average": "npm run build && node scripts/import-jpcenter-raize-average.cjs",
    "import:rocky-average": "npm run build && node scripts/import-jpcenter-rocky-average.cjs",
    "migrate:images:gridfs": "node scripts/migrate-images-to-gridfs.cjs",
    "seed": "tsx src/seed.ts",
    "recalculate:cars": "npm run build && node scripts/recalculate-car-prices.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "mongodb": "^7.5.0",
    "mongoose": "^8.24.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.5",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
